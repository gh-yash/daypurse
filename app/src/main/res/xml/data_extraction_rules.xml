<?xml version="1.0" encoding="utf-8"?>
<!--
  Never upload the app's data to cloud backup (it's personal finance data).
  A direct phone-to-phone transfer, which the user starts when setting up a new phone, may copy it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
