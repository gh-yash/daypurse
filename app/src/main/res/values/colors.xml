<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window/splash background; matches the Compose brand background so there's no flash. -->
    <color name="window_background">#FFF6FBF6</color>
    <color name="splash_icon_background">#FF1B6B4D</color>
    <!-- Home-screen widget: follows the wallpaper colours (Material You). -->
    <color name="widget_bg">@android:color/system_neutral1_50</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>
    <color name="widget_on_accent">@android:color/system_accent1_0</color>
    <color name="widget_chip">@android:color/system_accent1_100</color>
    <color name="widget_track">@android:color/system_accent1_100</color>
    <color name="widget_negative">#FFBA1A1A</color>
</resources>
